{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "sabah-fc",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-09",
  "keep_vars": true,
  "workers_dev": true,
  "build": {
    "command": "node tools/build-worker-assets.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/admin/*", "/api/notifications/*"]
  },
  "ratelimits": [{ "name": "ADMIN_LOGIN_RATE", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  "routes": [
    { "pattern": "sabahfc.esukan.app", "custom_domain": true }
  ]
}
